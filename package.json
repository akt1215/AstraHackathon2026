{
  "name": "dm-is-real",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tabletop RPG where the model is the Dungeon Master and the game engine.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "vitest run --root .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "node --env-file-if-exists=.env --import tsx server/probe.ts",
    "dev:life": "concurrently -k -n world,view \"npm:dev:life:server\" \"npm:dev:life:client\"",
    "dev:life:server": "node --env-file-if-exists=.env --import tsx --watch server/life-server.ts",
    "dev:life:client": "vite --config vite.life.config.ts",
    "build:life": "vite build --config vite.life.config.ts",
    "play:life": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/life-server.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^9.26.0",
    "@babylonjs/loaders": "^9.26.0",
    "openai": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "concurrently": "^10",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^5"
  }
}
