# Copy these settings into the ignored .env file; keep the real key local.
LIFE_PROVIDER=openai
OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra
LIFE_PORT=8791
LIFE_DATA_FILE=data/life-session.json
LIFE_MODEL_TIMEOUT_MS=10000

# Optional previews without an OpenAI key:
# LIFE_PROVIDER=claude-cli
# CLAUDE_MODEL=sonnet
# LIFE_PROVIDER=offline
