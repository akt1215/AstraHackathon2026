# Server-only values. Never use the VITE_ prefix for credentials.
OPENAI_API_KEY=
# Set a Responses API model supporting Structured Outputs available to your account.
OPENAI_MODEL=gpt-5.6-terra
# Maximum generation attempts per local server process; failed calls also count.
OPENAI_MAX_GENERATIONS=20

# World interpretation and friendly NPC decisions. Local Claude CLI is the default.
ASTRA_PROVIDER=claude-cli
CLAUDE_MODEL=sonnet
# Set an absolute path if claude is not in PATH.
# CLAUDE_BIN=/absolute/path/to/claude
# For hosted/OpenAI world narration, also set OPENAI_API_KEY above.
# ASTRA_PROVIDER=openai
# ASTRA_MODEL=your_available_model
ASTRA_MODEL_TIMEOUT_MS=120000
